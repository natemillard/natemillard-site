---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/site/Prose.astro';
import Tag from '../../components/site/Tag.astro';
import { formatDate, slugifyTag } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout
  title={d.title}
  description={d.summary}
  image={d.image}
  noindex={d.draft || !d.listed}
  publishedDate={d.date}
>
  <article class="container">
    <header class="piece-head">
      <p class="piece-meta">
        <span class="piece-type">{d.type}</span>
        <span aria-hidden="true">·</span>
        <time datetime={d.date.toISOString()}>{formatDate(d.date, { day: true })}</time>
        {d.source && (<><span aria-hidden="true">·</span><span>{d.source}</span></>)}
      </p>

      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      {d.draft && <p class="status-note">Working draft — not linked from the site.</p>}
      {!d.draft && !d.listed && <p class="status-note">Unlisted — reachable by direct link only.</p>}

      {d.externalUrl && (
        <p class="piece-external">
          <a class="button button--secondary" href={d.externalUrl} rel="noopener" target="_blank">
            Read the full piece at {d.source ?? 'the publisher'} ↗
          </a>
        </p>
      )}

      {d.doi && (
        <p class="piece-doi">
          DOI <a href={`https://doi.org/${d.doi}`} rel="noopener" target="_blank">{d.doi}</a>
        </p>
      )}
    </header>

    {d.image && <img class="piece-image" src={d.image} alt={d.imageAlt ?? ''} />}

    <Prose class:list={['piece-body', { 'prose--verse': d.type === 'poem' }]}><Content /></Prose>

    {d.gallery.length > 0 && (
      <section class="piece-photos" aria-label="Photographs">
        {d.gallery.map((img) => (
          <figure>
            <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    {d.tags.length > 0 && (
      <footer class="piece-tags">
        {d.tags.map((t) => <Tag tag={t} href={`/writing/tag/${slugifyTag(t)}`} />)}
      </footer>
    )}

    <p class="piece-back"><a class="link-arrow" href="/writing">All writing &amp; research</a></p>
  </article>
</BaseLayout>

<style>
  .piece-head {
    padding-block: var(--space-2xl) var(--space-lg);
    max-width: var(--width-text);
  }

  .piece-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    margin-bottom: var(--space-xs);
  }

  .piece-type {
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .piece-head h1 { font-size: var(--text-3xl); }
  .piece-head .lede { margin-top: var(--space-md); }

  .status-note {
    margin-top: var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-clay);
  }

  .piece-external { margin-top: var(--space-lg); }

  .piece-doi {
    margin-top: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
  }

  /* A sequence, not a grid. One photograph at a time, in the order given,
     so a run of pictures reads as a chronology rather than a contact sheet.
     Images are never cropped here: the shape each one was taken in is part
     of what it is. */
  .piece-photos {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .piece-photos figure { margin: 0; }

  .piece-photos img {
    display: block;
    /* Capped in BOTH directions and never stretched. A tall photograph at
       full reading width runs a thousand pixels down the page and turns a
       short sequence into a scroll; capping the height instead lets a
       portrait sit narrower than a landscape, which is also the truer shape
       for it. Small originals stay small rather than being blown up. */
    max-width: 100%;
    max-height: 32rem;
    width: auto;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule);
  }

  .piece-photos figcaption {
    margin-top: var(--space-2xs);
    max-width: 46ch;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink-faint);
  }

  .piece-image {
    width: 100%;
    max-height: 30rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule);
    margin-bottom: var(--space-xl);
  }

  .piece-tags {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
    max-width: var(--width-prose);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .piece-back { margin-top: var(--space-lg); }
</style>
