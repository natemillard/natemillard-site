---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import WritingCard from '../../components/cards/WritingCard.astro';
import Tag from '../../components/site/Tag.astro';
import ContactBlock from '../../components/site/ContactBlock.astro';
import { visible, byDateDesc, writingTags } from '../../lib/content';

const entries = (await visible('writing')).sort(byDateDesc('date'));
const tags = await writingTags();

/* Two lanes rather than one list. A peer-reviewed article and a poem do
   each other no favours in the same reverse-chronological run: a colleague
   scanning for research should not wade through verse, and a reader who came
   for the poems should not hit a grant report. */
const LANES = [
  {
    id: 'work',
    heading: 'Research & essays',
    note: 'Published research, essays, and talks.',
    types: ['research', 'publication', 'essay', 'talk'],
  },
  {
    id: 'creative',
    heading: 'Poems & stories',
    note: 'Creative nonfiction and poems, some going back twenty years.',
    types: ['nonfiction', 'poem', 'fiction', 'reflection'],
  },
];

const lanes = LANES.map((lane) => ({
  ...lane,
  items: entries.filter((e) => lane.types.includes(e.data.type)),
})).filter((lane) => lane.items.length > 0);
---

<BaseLayout
  title="Writing & Research"
  description="Essays, research, publications, talks, and reflections."
>
  <div class="container">
    <PageHeader
      eyebrow="Writing"
      title="Writing"
      lede="Creative nonfiction and poems, written over about fifteen years — mostly about water, place, and paying attention to both."
    />

    {tags.length > 0 && (
      <nav class="tag-bar" aria-label="Browse by topic">
        <span class="tag-bar__label">Topics</span>
        <div class="tag-bar__tags">
          {tags.map((t) => (
            <Tag tag={t.tag} count={t.count} href={`/writing/tag/${t.slug}`} />
          ))}
        </div>
      </nav>
    )}

    {lanes.map((lane) => (
      <section class="lane">
        {lanes.length > 1 && (
          <div class="lane__head">
            <h2 class="lane__heading">{lane.heading}</h2>
            <p class="lane__note">{lane.note}</p>
          </div>
        )}
        <div class="lane__list">
          {/* With the lane heading hidden there is no <h2> above the cards,
              so they step up a level to keep the heading order unbroken. */}
          {lane.items.map((entry) => (
            <WritingCard entry={entry} headingLevel={lanes.length > 1 ? 3 : 2} />
          ))}
        </div>
      </section>
    ))}

    {entries.length === 0 && <p class="empty">No writing published yet.</p>}
  </div>

  <ContactBlock />
</BaseLayout>

<style>
  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }

  .tag-bar__label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-ink-faint);
  }

  .tag-bar__tags { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }

  .lane { margin-top: var(--space-2xl); }

  .lane__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--color-rule);
  }

  .lane__heading { font-size: var(--text-xl); }

  .lane__note {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
  }

  .lane__list > :first-child { padding-top: var(--space-sm); }

  .empty { color: var(--color-ink-muted); }
</style>
