---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/site/Prose.astro';
import Tag from '../../components/site/Tag.astro';
import ContactBlock from '../../components/site/ContactBlock.astro';
import { formatRange } from '../../lib/content';

/* Every project gets a page, including drafts and unlisted ones — they are
   simply kept out of listings and out of search engines. */
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout
  title={d.title}
  description={d.summary}
  image={d.image}
  noindex={d.draft || !d.listed}
>
  <article class="container">
    <header class="project-head">
      <p class="eyebrow"><a href="/work">Work</a></p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      {(d.draft || !d.listed) && (
        <p class="status-note">
          {d.draft ? 'Working draft — not linked from the site.' : 'Unlisted — reachable by direct link only.'}
        </p>
      )}

      <dl class="project-meta">
        <div>
          <dt>Role</dt>
          <dd>{d.role}</dd>
        </div>
        <div>
          <dt>Dates</dt>
          <dd>{formatRange(d.startDate, d.endDate, d.ongoing)}</dd>
        </div>
        {d.collaborators.length > 0 && (
          <div>
            <dt>With</dt>
            <dd>{d.collaborators.join(', ')}</dd>
          </div>
        )}
      </dl>
    </header>

    {d.image && (
      <img class="project-image" src={d.image} alt={d.imageAlt ?? ''} />
    )}

    <div class="project-body">
      <Prose><Content /></Prose>

      {d.outcomes.length > 0 && (
        <section class="panel">
          <h2>Outcomes</h2>
          <ul class="panel__list">
            {d.outcomes.map((o) => <li>{o}</li>)}
          </ul>
        </section>
      )}

      {d.gallery.length > 0 && (
        <section class="gallery">
          {d.gallery.map((img) => (
            <figure>
              <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      {(d.links.length > 0 || d.downloads.length > 0) && (
        <section class="panel">
          <h2>Related</h2>
          <ul class="panel__list">
            {d.links.map((l) => (
              <li><a href={l.href} rel="noopener" target="_blank">{l.label} ↗</a></li>
            ))}
            {d.downloads.map((l) => (
              <li>
                <a href={l.href} download>{l.label}</a>
                {l.note && <span class="panel__note"> — {l.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {d.tags.length > 0 && (
        <p class="project-tags">
          {d.tags.map((t) => <Tag tag={t} />)}
        </p>
      )}
    </div>
  </article>

  <ContactBlock />
</BaseLayout>

<style>
  .project-head {
    padding-block: var(--space-2xl) var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
    max-width: var(--width-text);
  }

  .project-head .eyebrow { margin-bottom: var(--space-xs); }
  .project-head .eyebrow a { color: inherit; text-decoration: none; }
  .project-head .eyebrow a:hover { color: var(--color-accent); }

  .project-head h1 { font-size: var(--text-3xl); }
  .project-head .lede { margin-top: var(--space-md); }

  .status-note {
    margin-top: var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-clay);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    font-family: var(--font-sans);
  }

  .project-meta dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-ink-faint);
  }

  .project-meta dd {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink);
    max-width: 30ch;
  }

  .project-image {
    margin-top: var(--space-xl);
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule);
  }

  .project-body { margin-top: var(--space-xl); }

  .panel {
    margin-top: var(--space-xl);
    max-width: var(--width-prose);
    padding: var(--space-md);
    background: var(--color-paper-sunk);
    border-radius: var(--radius-md);
  }

  .panel h2 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-family: var(--font-sans);
    color: var(--color-ink-faint);
  }

  .panel__list {
    margin-top: var(--space-2xs);
    padding-left: 1.1em;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .panel__list li + li { margin-top: var(--space-2xs); }
  .panel__note { color: var(--color-ink-faint); }

  .gallery {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 44rem) {
    .gallery { grid-template-columns: 1fr 1fr; }
  }

  .gallery img {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule);
  }

  .gallery figcaption {
    margin-top: var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
  }

  .project-tags {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
</style>
