---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import LabDisclaimer from '../../components/training/LabDisclaimer.astro';
import ContactBlock from '../../components/site/ContactBlock.astro';
import { visible } from '../../lib/content';
import { phases, skillsInPhase } from '../../lib/cm';

const all = await visible('trainings');

/* Modules that belong to the numbered curriculum, in order. */
const numbered = all
  .filter((t) => t.data.skillNumber !== undefined)
  .sort((a, b) => (a.data.skillNumber ?? 0) - (b.data.skillNumber ?? 0));

/* Group by track, preserving first-seen order so the curriculum defines
   its own grouping rather than this page hard-coding it. */
const tracks: { name: string; items: typeof numbered }[] = [];
for (const entry of numbered) {
  const name = entry.data.track ?? 'Skills';
  let group = tracks.find((t) => t.name === name);
  if (!group) { group = { name, items: [] }; tracks.push(group); }
  group.items.push(entry);
}

const trackLabel: Record<string, string> = {
  foundational: 'The two foundational skills',
  applied: 'The eleven applied skills',
};

/* Anything outside the numbered curriculum. */
const other = all.filter((t) => t.data.skillNumber === undefined);

const total = numbered.length;

/* The phase spine. Skills are the depth; phases are the order you meet them
   in, so the Lab leads with the question "where am I" before "what is this". */
const spine = await Promise.all(
  (await phases()).map(async (phase) => ({
    phase,
    loadBearing: (await skillsInPhase(phase.data.code)).loadBearing.length,
  }))
);

---

<BaseLayout
  noindex
  title="Training Lab"
  description="Interactive learner pages and training prototypes on community mobilization — what a skill is, one framework, things to try, and a short self-check."
>
  <div class="container">
    <PageHeader
      eyebrow="Training Lab"
      title="Community mobilization skills"
      lede={`${total} skills. Each page takes about twenty minutes: what the skill is, one framework, a few things to try on your own, and five questions to see where you stand.`}
    />

    <div class="lab-intro">
      <div class="lab-intro__text">
        <p>
          Start anywhere. The first two are relational and everything else draws
          on them, so if you are not sure where to begin, begin there.
        </p>
        <p>
          These are prototypes of an interactive format. The self-check at the
          foot of each page responds to your answers rather than asking you to
          tally them yourself, and every page works without JavaScript if you
          would rather read it on paper.
        </p>
      </div>

      <div class="lab-intro__note">
        <h2 class="lab-intro__note-heading">A note on what this is</h2>
        <LabDisclaimer variant="full" />
      </div>
    </div>

    <section class="spine">
      <div class="spine__head">
        <h2>Start with where you are</h2>
        <p>
          Planning runs in five phases, and each one leans hard on a handful of
          skills and touches the rest lightly. If you are not sure which skill
          you need, that is the right question and this is where it gets
          answered.
        </p>
      </div>

      <ol class="spine__list">
        {spine.map(({ phase, loadBearing }) => (
          <li>
            <a class="spine__item" href={`/training/phases/${phase.id}`}>
              <span class="spine__code">{phase.data.code}</span>
              <span class="spine__title">{phase.data.title}</span>
              <span class="spine__sub">{phase.data.subtitle}</span>
              <span class="spine__n">
                {loadBearing} {loadBearing === 1 ? 'skill' : 'skills'}
              </span>
            </a>
          </li>
        ))}
      </ol>

      <p class="spine__more">
        <a class="link-arrow" href="/training/phases">All five phases</a>
      </p>
    </section>

    {tracks.map((track) => (
      <section class="track">
        <h2 class="track__heading">{trackLabel[track.name] ?? track.name}</h2>
        <ol class="skills">
          {track.items.map((entry) => (
            <li class="skill">
              <a class="skill__link" href={`/training/${entry.id}`}>
                <span class="skill__num">
                  {String(entry.data.skillNumber).padStart(2, '0')}
                </span>
                <span class="skill__text">
                  <span class="skill__title">{entry.data.title}</span>
                  <span class="skill__summary">{entry.data.summary}</span>
                </span>
                <span class="skill__time">{entry.data.duration}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section class="concepts-nav">
      <h2>Underneath the skills</h2>
      <div class="concepts-nav__grid">
        <a class="concepts-nav__card" href="/training/mindsets">
          <span class="concepts-nav__n">6</span>
          <span class="concepts-nav__title">Mindsets</span>
          <span class="concepts-nav__text">
            What you bring into the room. Dispositions, not techniques, and
            every skill asks for three of them.
          </span>
        </a>
        <a class="concepts-nav__card" href="/training/frameworks">
          <span class="concepts-nav__n">16</span>
          <span class="concepts-nav__title">Frameworks</span>
          <span class="concepts-nav__text">
            Published models the skills borrow from, each with the work it
            comes out of.
          </span>
        </a>
      </div>
    </section>

    {other.length > 0 && (
      <section class="track">
        <h2 class="track__heading">Other prototypes</h2>
        <ol class="skills">
          {other.map((entry) => (
            <li class="skill">
              <a class="skill__link" href={`/training/${entry.id}`}>
                <span class="skill__num">—</span>
                <span class="skill__text">
                  <span class="skill__title">{entry.data.title}</span>
                  <span class="skill__summary">{entry.data.summary}</span>
                </span>
                <span class="skill__time">{entry.data.duration}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <p class="lab-foot">
      Each of these has a longer facilitator pack behind it for anyone who wants
      to run a session for their team.
    </p>
  </div>

  <ContactBlock
    heading="Want to run one of these?"
    text="These get better when someone else takes them into a real room. If you would like to adapt a module for your own group, or want the facilitator materials that are not published here, get in touch."
  />
</BaseLayout>

<style>
  .spine {
    margin-bottom: var(--section-gap);
    max-width: var(--width-text);
  }

  .spine__head h2 { font-size: var(--text-xl); }

  .spine__head p {
    margin-top: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .spine__list {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }

  .spine__item {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
    font-family: var(--font-sans);
  }

  .spine__code {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
  }

  .spine__title { font-weight: 600; }
  .spine__item:hover .spine__title { color: var(--color-clay); }

  .spine__n {
    grid-row: span 2;
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .spine__sub {
    grid-column: 2;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-ink-faint);
  }

  .spine__more { margin-top: var(--space-sm); }

  .concepts-nav {
    margin-block: var(--section-gap);
    max-width: var(--width-text);
  }

  .concepts-nav h2 { font-size: var(--text-xl); }

  .concepts-nav__grid {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  @media (min-width: 40rem) {
    .concepts-nav__grid { grid-template-columns: 1fr 1fr; }
  }

  .concepts-nav__card {
    display: block;
    padding: var(--space-md);
    background: var(--color-paper-sunk);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
  }

  .concepts-nav__card:hover { background: var(--color-clay-wash); }

  .concepts-nav__n {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-clay);
  }

  .concepts-nav__title {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    margin-top: var(--space-3xs);
  }

  .concepts-nav__text {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: var(--leading-normal);
  }

  .lab-intro {
    display: grid;
    align-items: start;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 60rem) {
    .lab-intro {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  .lab-intro__text p {
    max-width: 58ch;
    color: var(--color-ink-muted);
  }

  .lab-intro__text p + p { margin-top: var(--space-sm); }

  .lab-intro__note {
    padding: var(--space-md);
    background: var(--color-clay-wash);
    border-radius: var(--radius-md);
  }

  .lab-intro__note-heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-clay);
    margin-bottom: var(--space-2xs);
  }

  /* ---------- Skill list ---------- */

  .track { margin-top: var(--space-2xl); }

  .track__heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-ink-faint);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--color-rule);
  }

  .skills {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skill + .skill { border-top: 1px solid var(--color-rule); }

  .skill__link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-sm);
    align-items: baseline;
    padding: var(--space-md) var(--space-2xs);
    text-decoration: none;
    color: inherit;
    transition: background var(--duration) var(--ease);
  }

  @media (min-width: 44rem) {
    .skill__link {
      grid-template-columns: 2.5rem minmax(0, 1fr) 9rem;
      align-items: baseline;
    }
  }

  .skill__link:hover { background: var(--color-paper-sunk); }

  .skill__num {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-clay);
  }

  .skill__text { display: grid; gap: var(--space-3xs); }

  .skill__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .skill__link:hover .skill__title { color: var(--color-clay-hover); }

  .skill__summary {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 58ch;
  }

  .skill__time {
    grid-column: 2;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  @media (min-width: 44rem) {
    .skill__time { grid-column: 3; text-align: right; }
  }

  .lab-foot {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
    max-width: 60ch;
  }
</style>
