---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import TrainingCard from '../../components/cards/TrainingCard.astro';
import LabDisclaimer from '../../components/training/LabDisclaimer.astro';
import ContactBlock from '../../components/site/ContactBlock.astro';
import { visible } from '../../lib/content';

const trainings = (await visible('trainings')).sort(
  (a, b) => b.data.updated.getTime() - a.data.updated.getTime()
);
---

<BaseLayout
  title="Training Lab"
  description="Training concepts, prototypes, and interactive learning tools for community resilience and preparedness."
>
  <div class="container">
    <PageHeader
      eyebrow="Training Lab"
      title="Training concepts, prototypes, and learning tools"
      lede="This is a workshop rather than a catalogue. What's here are session designs, scenario exercises, and interactive tools I am developing — some ready to run with a real group, some still arguments with myself about how a thing should work."
    />

    <div class="lab-intro">
      <div class="lab-intro__text">
        <h2>What you'll find here</h2>
        <p>
          Each module explains what it is for, who it is designed for, and how
          long it takes — then lets you work through the material yourself
          rather than only reading about it. Where a session has structure a
          facilitator would need, that is included too, in sections marked for
          facilitators.
        </p>
        <p>
          Every module carries a provenance line saying where it came from and
          what it is not. That matters to me: prototypes should be legible as
          prototypes.
        </p>
      </div>

      <div class="lab-intro__note">
        <h2 class="lab-intro__note-heading">A note on what this is</h2>
        <LabDisclaimer variant="full" />
      </div>
    </div>

    {trainings.length === 0 ? (
      <p class="empty">No modules published yet.</p>
    ) : (
      <section class="lab-list">
        <h2 class="lab-list__heading">Modules</h2>
        <div class="lab-grid">
          {trainings.map((entry) => <TrainingCard entry={entry} />)}
        </div>
      </section>
    )}
  </div>

  <ContactBlock
    heading="Interested in running one of these?"
    text="These are prototypes, and they get better when someone else takes them into a real room. If you would like to adapt a module for your own group, or want the facilitator materials that are not published here, get in touch."
  />
</BaseLayout>

<style>
  .lab-intro {
    display: grid;
    align-items: start;
    gap: var(--space-xl);
    padding-bottom: var(--section-gap);
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 60rem) {
    .lab-intro { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-2xl); }
  }

  .lab-intro h2 { font-size: var(--text-lg); }

  .lab-intro__text p {
    margin-top: var(--space-sm);
    max-width: 58ch;
    color: var(--color-ink-muted);
  }

  .lab-intro__note {
    padding: var(--space-md);
    background: var(--color-clay-wash);
    border-radius: var(--radius-md);
  }

  .lab-intro__note-heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-clay);
    margin-bottom: var(--space-2xs);
  }

  .lab-list { margin-top: var(--section-gap); }

  .lab-list__heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-ink-faint);
    margin-bottom: var(--space-md);
  }

  .lab-grid { display: grid; gap: var(--space-md); }

  @media (min-width: 48rem) {
    .lab-grid { grid-template-columns: 1fr 1fr; }
  }

  .empty { color: var(--color-ink-muted); }
</style>
