---
import { getCollection, render } from 'astro:content';
import { mapFor } from '../../lib/cm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/site/Prose.astro';
import Tag from '../../components/site/Tag.astro';
import TrainingMeta from '../../components/training/TrainingMeta.astro';
import AffiliationLine from '../../components/training/AffiliationLine.astro';
import LabDisclaimer from '../../components/training/LabDisclaimer.astro';
import DownloadResource from '../../components/training/DownloadResource.astro';
import ScenarioCard from '../../components/training/ScenarioCard.astro';
import ReflectionPrompt from '../../components/training/ReflectionPrompt.astro';
import Quiz from '../../components/training/Quiz.astro';
import RevealCard from '../../components/training/RevealCard.astro';
import StepSequence from '../../components/training/StepSequence.astro';
import Step from '../../components/training/Step.astro';
import DecisionChoice from '../../components/training/DecisionChoice.astro';
import FacilitatorNote from '../../components/training/FacilitatorNote.astro';
import Callout from '../../components/training/Callout.astro';
import FrameworkGrid from '../../components/training/FrameworkGrid.astro';
import FrameworkItem from '../../components/training/FrameworkItem.astro';
import PracticeGrid from '../../components/training/PracticeGrid.astro';
import Practice from '../../components/training/Practice.astro';
import SelfAssessment from '../../components/training/SelfAssessment.astro';
import GoDeeper from '../../components/training/GoDeeper.astro';

/* Every training component is handed to MDX here, which means a training file
   can use <Quiz />, <ScenarioCard />, and the rest WITHOUT importing anything.
   Add a new component to this object and it becomes available in every
   training file automatically. */
const trainingComponents = {
  ScenarioCard,
  ReflectionPrompt,
  Quiz,
  RevealCard,
  StepSequence,
  Step,
  DecisionChoice,
  DownloadResource,
  FacilitatorNote,
  Callout,
  FrameworkGrid,
  FrameworkItem,
  PracticeGrid,
  Practice,
  SelfAssessment,
  GoDeeper,
};


export async function getStaticPaths() {
  const entries = await getCollection('trainings');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
/* Modules this one connects to. Today this renders as cross-links; it is also
   the data a "build me a session around X" tool would need later, which is why
   the relationships live in frontmatter rather than being written by hand into
   the prose. */
const allTrainings = await getCollection('trainings');

/* Does this skill have an activity bank behind it? */
const allExercises = await getCollection('exercises');
const packItems = allExercises.filter((e) => e.data.skill === entry.id);
const packCounts = [...new Set(packItems.map((e) => e.data.typeLabel))]
  .map((label) => ({ label, n: packItems.filter((e) => e.data.typeLabel === label).length }))
  .sort((a, b) => b.n - a.n);
/* Phases, mindsets and frameworks this skill connects to. The links are
   written once in this file's frontmatter; every reverse view is derived. */
const map = await mapFor(entry);

const related = d.related
  .map((slug) => allTrainings.find((t) => t.id === slug))
  .filter((t) => t !== undefined && !t.data.draft && t.data.listed);
---

<BaseLayout
  title={d.title}
  description={d.summary}
  image={d.image}
  noindex={true} /* whole Training Lab is unlisted; see public/robots.txt */
>
  <article class="container training">
    <header class="training__head">
      <p class="eyebrow"><a href="/training">Training Lab</a></p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      {(d.draft || !d.listed) && (
        <p class="status-note">
          {d.draft
            ? 'Working draft — still being developed, and not linked from the Training Lab.'
            : 'Unlisted — reachable by direct link only, and not listed in the Training Lab.'}
        </p>
      )}

      <div class="training__affiliation">
        <AffiliationLine affiliation={d.affiliation} note={d.affiliationNote} />
      </div>
    </header>

    <div class="training__meta">
      <TrainingMeta
        audience={d.audience}
        duration={d.duration}
        format={d.format}
        stage={d.stage}
        objectives={d.objectives}
        updated={d.updated}
      />
    </div>

    <Prose class="training__body"><Content components={trainingComponents} /></Prose>

    {d.resources.length > 0 && (
      <section class="training__resources">
        <h2>Facilitation resources</h2>
        {d.resources.map((r) => (
          <DownloadResource label={r.label} href={r.href} kind={r.kind} note={r.note} />
        ))}
      </section>
    )}

    {d.tags.length > 0 && (
      <p class="training__tags">{d.tags.map((t) => <Tag tag={t} />)}</p>
    )}

    {(map.phases.length > 0 || map.mindsets.length > 0 || map.frameworks.length > 0) && (
      <section class="map">
        <h2>Where this sits</h2>

        {map.phases.length > 0 && (
          <div class="map__group">
            <h3>Phases</h3>
            <ul class="map__phases">
              {map.phases.map((p) => (
                <li>
                  <a href={`/training/phases/${p.phase.id}`}>
                    <span class="map__code">{p.phase.data.code}</span>
                    {p.phase.data.title}
                  </a>
                  <span class:list={['map__role', `map__role--${p.role}`]}>
                    {p.role}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {map.mindsets.length > 0 && (
          <div class="map__group">
            <h3>Mindsets it asks for</h3>
            <ul class="map__concepts">
              {map.mindsets.map((m) => (
                <li>
                  <a href={`/training/mindsets/${m.id}`}>{m.data.title}</a>
                  <span class="map__def">{m.data.definition}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {map.frameworks.length > 0 && (
          <div class="map__group">
            <h3>Frameworks it draws on</h3>
            <ul class="map__concepts">
              {map.frameworks.map((f) => (
                <li>
                  <a href={`/training/frameworks/${f.id}`}>{f.data.title}</a>
                  <span class="map__def">{f.data.definition}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    {packItems.length > 0 && (
      <section class="pack-link">
        <p class="pack-link__eyebrow">Go deeper</p>
        <h2>The activity bank behind this skill</h2>
        <p class="pack-link__text">
          {packItems.length} exercises for anyone running this with a group —
          {' '}{packCounts.map((c, i) => `${c.n} ${c.label.toLowerCase()}${c.n === 1 ? '' : 's'}`).join(', ')}.
        </p>
        <p>
          <a class="button" href={`/training/exercises/${entry.id}`}>
            Open the activity bank
          </a>
        </p>
        <p class="pack-link__note">
          Facilitator material rather than participant material. You can also
          <a href="/training/exercises"> browse every exercise across all skills</a>.
        </p>
      </section>
    )}

    {related.length > 0 && (
      <section class="training__related">
        <h2>Connects to</h2>
        <ul>
          {related.map((t) => (
            <li>
              <a href={`/training/${t!.id}`}>{t!.data.title}</a>
              <span class="training__related-note"> — {t!.data.summary}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="training__foot">
      <LabDisclaimer variant="short" />
      <p><a class="link-arrow" href="/training">All Training Lab modules</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  /* See the note in cv.astro — constrain the content, not the container. */
  .training > * { max-width: var(--width-text); }

  .training__head { padding-block: var(--space-2xl) var(--space-lg); }

  .training__head .eyebrow { margin-bottom: var(--space-xs); }
  .training__head .eyebrow a { color: inherit; text-decoration: none; }
  .training__head .eyebrow a:hover { color: var(--color-clay); }

  .training__head h1 { font-size: var(--text-3xl); }
  .training__head .lede { margin-top: var(--space-md); }

  .status-note {
    margin-top: var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-clay);
  }

  .training__affiliation { margin-top: var(--space-lg); }

  .training__meta { margin-bottom: var(--space-2xl); }

  /* Training bodies run wider than an essay: the interactive components need
     the room, and .prose-wide children opt out of the reading measure. */
  .training__body { max-width: var(--width-prose); }
  .training__body :global(.prose-wide) { max-width: none; }

  .map {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-rule);
  }

  .map h2 { font-size: var(--text-xl); }

  .map__group { margin-top: var(--space-lg); }

  .map__group h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-ink-faint);
  }

  .map__phases,
  .map__concepts {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
  }

  .map__phases li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    padding-block: var(--space-3xs);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .map__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    margin-right: var(--space-3xs);
  }

  .map__role {
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .map__role--load-bearing { color: var(--color-clay); }

  .map__concepts li { padding-block: var(--space-2xs); }

  .map__def {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: var(--leading-normal);
    margin-top: var(--space-3xs);
  }

  .training__resources {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }

  .training__resources h2 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-ink-faint);
    margin-bottom: var(--space-2xs);
  }

  .pack-link {
    margin-top: var(--space-2xl);
    padding: var(--space-lg);
    border: 1px solid var(--color-rule);
    border-top: 3px solid var(--color-clay);
    border-radius: var(--radius-md);
    background: var(--color-clay-wash);
  }

  .pack-link__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-clay);
  }

  .pack-link h2 {
    margin-top: var(--space-2xs);
    font-size: var(--text-xl);
  }

  .pack-link__text {
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-md);
    color: var(--color-ink-muted);
    max-width: 56ch;
  }

  .pack-link__note {
    margin-top: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
  }

  .training__related {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }

  .training__related h2 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-ink-faint);
  }

  .training__related ul {
    margin-top: var(--space-2xs);
    padding-left: 1.1em;
    line-height: var(--leading-normal);
  }

  .training__related li + li { margin-top: var(--space-2xs); }

  .training__related-note {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .training__tags {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .training__foot {
    margin-top: var(--space-2xl);
    display: grid;
    gap: var(--space-md);
  }

  @media print {
    .training__foot { break-inside: avoid; }
  }
</style>
