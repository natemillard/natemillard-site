---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConceptPage from '../../../components/training/ConceptPage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('mindsets');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<BaseLayout noindex title={entry.data.title} description={entry.data.definition}>
  <ConceptPage entry={entry} kind="mindsets" />
</BaseLayout>
