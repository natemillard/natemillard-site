---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/site/PageHeader.astro';
import ConceptList from '../../../components/training/ConceptList.astro';
import LabDisclaimer from '../../../components/training/LabDisclaimer.astro';
---

<BaseLayout
  noindex
  title="Mindsets"
  description="The six dispositions the community mobilization skills are built on."
>
  <div class="container">
    <PageHeader
      eyebrow="Training Lab"
      title="Six mindsets"
      lede="A mindset is what you bring into the room, not a technique you apply once you are in it. These six run underneath all thirteen skills. Overlap is the point: a mindset that shows up in ten skills is load-bearing, not lazily assigned."
    />
    <ConceptList kind="mindsets" />
    <div class="foot"><LabDisclaimer variant="short" /></div>
  </div>
</BaseLayout>

<style>
  .foot {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
    max-width: var(--width-text);
  }
</style>
