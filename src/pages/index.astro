---
/* =========================================================================
   HOMEPAGE
   ------------------------------------------------------------------------
   ⚠ ALL PROSE IN THIS FILE IS PLACEHOLDER COPY. It is written to sound like
   something you might actually say, so the design can be judged honestly —
   but every sentence needs replacing. See PLACEHOLDERS.md.
   ========================================================================= */

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/site/ContactBlock.astro';
import ProjectCard from '../components/cards/ProjectCard.astro';
import WritingCard from '../components/cards/WritingCard.astro';
import { visible, byDateDesc } from '../lib/content';
import { site } from '../config';

const projects = (await visible('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 2);

const writing = (await visible('writing'))
  .sort(byDateDesc('date'))
  .slice(0, 4);
---

<BaseLayout title={site.name} description={site.description}>
  <!-- ---------- Introduction ---------- -->
  <section class="intro">
    <div class="container">
      <h1 class="intro__statement">
        I work on how communities and organisations find their way to acting
        together — and on the learning that makes collaboration hold.
      </h1>

      <div class="intro__body">
        <p>
          I design learning and facilitate the work of collaboration — helping
          organisations that serve the same people find the overlap, and helping
          the people closest to a problem get into the room where it is decided.
        </p>
        <p>
          Most of the hard problems I have worked on were not short of good
          intentions or capable people. They were short of a way for those
          people to act together. Closing that gap is slower than writing a
          plan, and it is the part that lasts.
        </p>
        <p class="intro__links">
          <a class="link-arrow" href="/about">More about my background</a>
          <a class="link-arrow" href="/cv">Curriculum vitae</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ---------- Selected work ---------- -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Selected work</h2>
        <a class="link-arrow" href="/work">All projects</a>
      </div>

      <div class="work-grid">
        {projects.map((entry) => <ProjectCard entry={entry} />)}
      </div>
    </div>
  </section>

  <!-- ---------- Writing ---------- -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Recent writing</h2>
        <a class="link-arrow" href="/writing">All writing &amp; research</a>
      </div>

      <div class="writing-list">
        {writing.map((entry) => <WritingCard entry={entry} />)}
      </div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>

<style>
  /* ---------- Introduction ---------- */

  .intro {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) var(--space-2xl);
    border-bottom: 1px solid var(--color-rule);
  }

  .intro__statement {
    font-size: var(--text-3xl);
    font-weight: var(--weight-normal);
    line-height: 1.22;
    letter-spacing: var(--tracking-tight);
    max-width: 22ch;
  }

  .intro__body {
    margin-top: var(--space-xl);
    max-width: var(--width-prose);
    color: var(--color-ink-muted);
  }

  .intro__body > p + p { margin-top: var(--space-sm); }

  .intro__links {
    margin-top: var(--space-lg) !important;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  @media (min-width: 60rem) {
    .intro__statement { max-width: 24ch; font-size: var(--text-4xl); }

    .intro__body {
      margin-left: auto;
      margin-right: 0;
      margin-top: var(--space-2xl);
    }
  }

  /* ---------- Section headings ---------- */

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-lg);
  }

  .section-head h2 { font-size: var(--text-xl); }

  /* ---------- Work ---------- */

  .work-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 44rem) {
    .work-grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
  }

  /* ---------- Writing ---------- */

  .writing-list > :first-child { padding-top: 0; }
</style>
