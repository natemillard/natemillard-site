---
/* =========================================================================
   HOMEPAGE
   ------------------------------------------------------------------------
   ⚠ ALL PROSE IN THIS FILE IS PLACEHOLDER COPY. It is written to sound like
   something you might actually say, so the design can be judged honestly —
   but every sentence needs replacing. See PLACEHOLDERS.md.
   ========================================================================= */

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/site/ContactBlock.astro';
import ProjectCard from '../components/cards/ProjectCard.astro';
import TrainingCard from '../components/cards/TrainingCard.astro';
import WritingCard from '../components/cards/WritingCard.astro';
import { visible, byDateDesc } from '../lib/content';
import { site } from '../config';

const projects = (await visible('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 2);

const trainings = (await visible('trainings'))
  .filter((t) => t.data.featured)
  .slice(0, 2);

const writing = (await visible('writing'))
  .sort(byDateDesc('date'))
  .slice(0, 4);
---

<BaseLayout title={site.name} description={site.description}>
  <!-- ---------- Introduction ---------- -->
  <section class="intro">
    <div class="container">
      <h1 class="intro__statement">
        I work on how communities prepare for, absorb, and recover from
        disruption — and on the kinds of learning that make that possible.
      </h1>

      <div class="intro__body">
        <p>
          I am a researcher and training designer based in Northern California.
          Most of my work sits in the space between two questions: what actually
          helps people when something goes wrong, and how do we teach that in a
          way that sticks.
        </p>
        <p>
          That has meant interviewing households two years into a recovery that
          has no obvious end, sitting in church basements while neighbours work
          out who has a truck, and rebuilding volunteer trainings that were
          losing people in the first hour.
        </p>
        <p class="intro__links">
          <a class="link-arrow" href="/about">More about my background</a>
          <a class="link-arrow" href="/cv">Curriculum vitae</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ---------- Selected work ---------- -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Selected work</h2>
        <a class="link-arrow" href="/work">All projects</a>
      </div>

      <div class="work-grid">
        {projects.map((entry) => <ProjectCard entry={entry} />)}
      </div>
    </div>
  </section>

  <!-- ---------- Training Lab ---------- -->
  <section class="lab">
    <div class="container">
      <div class="lab__intro">
        <p class="eyebrow lab__eyebrow">Training Lab</p>
        <h2>Learning experiences, built in the open</h2>
        <p class="lab__text">
          The Training Lab is where I develop and test training concepts —
          scenario exercises, facilitation structures, and interactive tools for
          building community capacity. Some are ready to run; some are still
          arguments with myself about how a thing should work. They are personal
          prototypes rather than official products of any organisation.
        </p>
        <p><a class="link-arrow" href="/training">Enter the Training Lab</a></p>
      </div>

      <div class="lab__grid">
        {trainings.map((entry) => <TrainingCard entry={entry} />)}
      </div>
    </div>
  </section>

  <!-- ---------- Writing ---------- -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Recent writing</h2>
        <a class="link-arrow" href="/writing">All writing &amp; research</a>
      </div>

      <div class="writing-list">
        {writing.map((entry) => <WritingCard entry={entry} />)}
      </div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>

<style>
  /* ---------- Introduction ---------- */

  .intro {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) var(--space-2xl);
    border-bottom: 1px solid var(--color-rule);
  }

  .intro__statement {
    font-size: var(--text-3xl);
    font-weight: var(--weight-normal);
    line-height: 1.22;
    letter-spacing: var(--tracking-tight);
    max-width: 22ch;
  }

  .intro__body {
    margin-top: var(--space-xl);
    max-width: var(--width-prose);
    color: var(--color-ink-muted);
  }

  .intro__body > p + p { margin-top: var(--space-sm); }

  .intro__links {
    margin-top: var(--space-lg) !important;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  @media (min-width: 60rem) {
    .intro__statement { max-width: 24ch; font-size: var(--text-4xl); }

    .intro__body {
      margin-left: auto;
      margin-right: 0;
      margin-top: var(--space-2xl);
    }
  }

  /* ---------- Section headings ---------- */

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-lg);
  }

  .section-head h2 { font-size: var(--text-xl); }

  /* ---------- Work ---------- */

  .work-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 44rem) {
    .work-grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
  }

  /* ---------- Training Lab band ---------- */

  .lab {
    background: var(--color-clay-wash);
    border-block: 1px solid var(--color-rule);
    padding-block: var(--section-gap);
  }

  .lab .container {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 60rem) {
    .lab .container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .lab__eyebrow { color: var(--color-clay); }

  .lab__intro h2 {
    margin-top: var(--space-xs);
    font-size: var(--text-2xl);
    max-width: 24ch;
  }

  .lab__text {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  .lab__intro .link-arrow { color: var(--color-clay); }
  .lab__intro .link-arrow:hover { color: var(--color-clay-hover); }

  .lab__grid {
    display: grid;
    gap: var(--space-md);
  }

  /* ---------- Writing ---------- */

  .writing-list > :first-child { padding-top: 0; }
</style>
