---
import type { CollectionEntry } from 'astro:content';

interface Props {
  headingLevel?: 2 | 3;
  entry: CollectionEntry<'trainings'>;
}
/* Cards sit under a section <h2> by default, so their own heading is an
   <h3>. Index pages that place cards directly under the page <h1> pass
   headingLevel={2} to keep the heading order unbroken. */
const Heading = `h${Astro.props.headingLevel ?? 3}` as any;
const { entry } = Astro.props;
const { title, summary, audience, duration, stage, draft } = entry.data;

const stageLabel: Record<string, string> = {
  concept: 'Concept',
  prototype: 'Prototype',
  'pilot-ready': 'Pilot ready',
  'field-tested': 'Field tested',
};
---

<article class="t-card">
  <a class="t-card__link" href={`/training/${entry.id}`}>
    <p class="t-card__meta">
      <span class="t-card__stage">{stageLabel[stage]}</span>
      <span aria-hidden="true">·</span>
      <span>{duration}</span>
      {draft && <span class="t-card__draft">Draft</span>}
    </p>

    <Heading class="t-card__title">{title}</Heading>
    <p class="t-card__summary">{summary}</p>

    <p class="t-card__audience">
      <span class="t-card__audience-label">For</span> {audience}
    </p>
  </a>
</article>

<style>
  .t-card {
    border: 1px solid var(--color-rule);
    border-left: 2px solid var(--color-clay);
    border-radius: var(--radius-md);
    background: var(--color-paper-raised);
    transition: border-color var(--duration) var(--ease),
                box-shadow var(--duration) var(--ease);
    height: 100%;
  }

  .t-card:hover {
    border-color: var(--color-rule-strong);
    border-left-color: var(--color-clay-hover);
    box-shadow: var(--shadow-sm);
  }

  .t-card__link {
    display: block;
    height: 100%;
    padding: var(--space-md);
    text-decoration: none;
    color: inherit;
  }

  .t-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .t-card__stage {
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
    color: var(--color-clay);
  }

  .t-card__draft {
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-faint);
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    padding: 0 0.4em;
  }

  .t-card__title {
    margin-top: var(--space-2xs);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .t-card__link:hover .t-card__title { color: var(--color-clay-hover); }

  .t-card__summary {
    margin-top: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .t-card__audience {
    margin-top: var(--space-sm);
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .t-card__audience-label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
  }
</style>
