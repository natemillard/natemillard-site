---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/content';

interface Props {
  headingLevel?: 2 | 3;
  entry: CollectionEntry<'writing'>;
  /** Compact rows for the homepage; full cards for the archive. */
  compact?: boolean;
}
/* Cards sit under a section <h2> by default, so their own heading is an
   <h3>. Index pages that place cards directly under the page <h1> pass
   headingLevel={2} to keep the heading order unbroken. */
const Heading = `h${Astro.props.headingLevel ?? 3}` as any;
const { entry, compact = false } = Astro.props;
const { title, date, type, summary, source, externalUrl, draft } = entry.data;
const href = externalUrl ?? `/writing/${entry.id}`;
const external = Boolean(externalUrl);
---

<article class:list={['w-card', { 'w-card--compact': compact }]}>
  <p class="w-card__meta">
    <span class="w-card__type">{type}</span>
    <span aria-hidden="true">·</span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {source && (<><span aria-hidden="true">·</span><span class="w-card__source">{source}</span></>)}
    {draft && <span class="w-card__draft">Draft</span>}
  </p>

  <Heading class="w-card__title">
    <a href={href} rel={external ? 'noopener' : undefined} target={external ? '_blank' : undefined}>
      {title}{external && <span class="w-card__ext" aria-label=" (opens in a new tab)">↗</span>}
    </a>
  </Heading>

  {!compact && <p class="w-card__summary">{summary}</p>}
</article>

<style>
  .w-card { padding-block: var(--space-md); border-bottom: 1px solid var(--color-rule); }

  .w-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .w-card__type {
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .w-card__draft {
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
    color: var(--color-clay);
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    padding: 0 0.4em;
  }

  .w-card__title {
    margin-top: var(--space-3xs);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    font-weight: var(--weight-medium);
  }

  .w-card__title a { color: var(--color-ink); text-decoration: none; }
  .w-card__title a:hover { color: var(--color-accent); text-decoration: underline; }

  .w-card__ext { font-size: 0.75em; margin-left: 0.25em; color: var(--color-ink-faint); }

  .w-card__summary {
    margin-top: var(--space-2xs);
    max-width: 62ch;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
</style>
