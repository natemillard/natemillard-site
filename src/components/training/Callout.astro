---
/**
 * A short emphasised line that names the move a section is making.
 *
 *   <Callout label="The shift">from assessing a community to inventorying it.</Callout>
 *   <Callout label="The check" tone="clay">if your map is mostly institutions…</Callout>
 */
interface Props {
  label: string;
  tone?: 'accent' | 'clay';
}
const { label, tone = 'accent' } = Astro.props;
---

<p class="callout prose-wide" data-tone={tone}>
  <span class="callout__label">{label}</span>
  <span class="callout__text"><slot /></span>
</p>

<style>
  .callout {
    margin-block: var(--space-md);
    padding: var(--space-xs) var(--space-md);
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-wash);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .callout[data-tone='clay'] {
    border-left-color: var(--color-clay);
    background: var(--color-clay-wash);
  }

  .callout__label {
    display: block;
    margin-bottom: var(--space-3xs);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .callout[data-tone='clay'] .callout__label { color: var(--color-clay); }
</style>
