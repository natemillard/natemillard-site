---
/**
 * A downloadable file — worksheet, slide deck, facilitator guide.
 * Put the file in public/downloads/ and point href at /downloads/name.pdf
 *
 *   <DownloadResource
 *     label="Asset walk worksheet"
 *     href="/downloads/worksheets/asset-walk.pdf"
 *     kind="PDF"
 *     note="Two pages, print double-sided"
 *   />
 */
interface Props {
  label: string;
  href: string;
  /** Small type label, e.g. 'PDF', 'Slides', 'Worksheet'. */
  kind?: string;
  note?: string;
}
const { label, href, kind, note } = Astro.props;
---

<a class="download prose-wide" href={href} download>
  <span class="download__icon" aria-hidden="true">↓</span>
  <span class="download__text">
    <span class="download__label">{label}</span>
    {(kind || note) && (
      <span class="download__meta">
        {kind && <span class="download__kind">{kind}</span>}
        {kind && note && <span aria-hidden="true"> · </span>}
        {note}
      </span>
    )}
  </span>
</a>

<style>
  .download {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-paper-raised);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration) var(--ease),
                background var(--duration) var(--ease);
  }

  .download:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  .download__icon {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--color-rule-strong);
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .download__text { display: grid; }

  .download__label {
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .download__meta {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .download__kind {
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
  }
</style>
