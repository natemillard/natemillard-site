---
import { site, nav, footerLinks, profiles } from '../../config';

const year = new Date().getFullYear();
const years = year > site.startYear ? `${site.startYear}–${year}` : `${site.startYear}`;
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{site.name}</p>
      <p class="footer__tagline">{site.tagline}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <ul class="footer__list">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        {footerLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer__nav" aria-label="Profiles">
      <ul class="footer__list">
        {profiles.map((item) => (
          <li>
            <a href={item.href} rel="me noopener" target="_blank">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container footer__base">
    <p>© {years} {site.name}</p>
    <p>Built with Astro. Hosted on Netlify.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--color-rule);
    padding-block: var(--space-xl) var(--space-lg);
    background: var(--color-paper-sunk);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }

  @media (min-width: 44rem) {
    .footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .footer__name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .footer__tagline {
    margin-top: var(--space-3xs);
    max-width: 28ch;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: var(--leading-normal);
  }

  .footer__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .footer__list a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .footer__list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .footer__base {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }
</style>
