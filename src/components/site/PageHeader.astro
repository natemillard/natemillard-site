---
/** Standard top-of-page block: eyebrow, title, optional lede. */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Constrain the lede to reading width. Default true. */
  narrow?: boolean;
}
const { eyebrow, title, lede, narrow = true } = Astro.props;
---

<div class="page-header">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class:list={['lede', { 'page-header__lede--narrow': narrow }]}>{lede}</p>}
  <slot />
</div>

<style>
  .page-header {
    padding-block: var(--space-2xl) var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--section-gap);
  }

  .page-header .eyebrow { margin-bottom: var(--space-xs); }

  .page-header h1 { max-width: 20ch; }

  .page-header .lede { margin-top: var(--space-md); }

  .page-header__lede--narrow { max-width: 55ch; }
</style>
