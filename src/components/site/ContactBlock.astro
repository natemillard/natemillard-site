---
/** Warm closing invitation, used at the foot of key pages. */
interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Get in touch',
  text = 'I am always glad to hear from people working on adjacent questions — practitioners, organisers, researchers, and anyone trying to get a group of organisations to move in the same direction.',
} = Astro.props;
---

<aside class="contact-block" aria-label="Contact">
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h2>{heading}</h2>
    <p class="contact-block__text">{text}</p>
    <p class="contact-block__actions">
      <a class="button" href="/contact">Send a message</a>
    </p>
  </div>
</aside>

<style>
  .contact-block {
    margin-top: var(--section-gap);
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-rule);
  }

  .contact-block .eyebrow { margin-bottom: var(--space-xs); }

  .contact-block h2 { font-size: var(--text-2xl); }

  .contact-block__text {
    margin-top: var(--space-sm);
    max-width: 52ch;
    color: var(--color-ink-muted);
  }

  .contact-block__actions { margin-top: var(--space-md); }
</style>
